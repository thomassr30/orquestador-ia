{
  "version": 1,
  "tema": "sensor-fallido-u-omitido",
  "nombre": "un control obligatorio que no termina queda «no verificado», no se repite sobre el mismo contenido y sigue pendiente",
  "archivos": { "src/a.js": "" },
  "config": { "sensores": { "alTerminar": ["tests"], "timeoutSeg": 1, "comandos": { "tests": "\"{node}\" -e \"setTimeout(()=>{},10000)\"" } } },
  "pasos": [
    { "evento": "post", "herramienta": { "kind": "edit", "name": "Write", "paths": ["src/a.js"], "contents": ["x"] } },
    { "evento": "stop", "ultimoMensaje": "Listo.", "espera": { "bloquea": true, "bloqueo": "obligatorio no se pudo verificar" } },
    { "evento": "stop", "ultimoMensaje": "Listo.", "espera": { "bloquea": false, "aviso": "no se vuelve a correr", "estado": { "sucio": true, "sensores.estado": "no_verificado" } } },
    { "evento": "stop", "ultimoMensaje": "Listo.", "espera": { "bloquea": false, "estado": { "sucio": true, "sensores.estado": "no_verificado" } } }
  ]
}
