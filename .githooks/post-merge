#!/bin/sh
# Orquestador SDD: reinstala automáticamente después de cada "git pull" que traiga cambios.
[ "$SDD_SKIP_HOOK" = "1" ] && exit 0
ROOT="$(git rev-parse --show-toplevel)"
echo ""
echo "[orquestador-sdd] Cambios recibidos. Actualizando la instalación global..."
node "$ROOT/install.js" || echo "[orquestador-sdd] La reinstalación falló. Ejecuta manualmente: node install.js"
